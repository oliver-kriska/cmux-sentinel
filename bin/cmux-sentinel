#!/bin/bash
# cmux-sentinel — one entry point for the whole toolkit.
#
# This is a DISPATCHER, not a rewrite. The nine cmux-*.sh scripts stay exactly
# where they are and keep working when called directly, because four LaunchAgents
# reference them by absolute path (~/bin/cmux-claude-usage.sh) and launchd holds
# its loaded definition until explicitly reloaded. Moving them would silently stop
# the meters on every already-bootstrapped install — the symptom being nothing at
# all, which is the failure mode this project keeps having to design against.
#
# Lookup order lets the same file work from a git checkout, a normal install, and
# a Homebrew prefix without edits:
#   1. beside this script      (repo checkout, or ~/bin after install)
#   2. ../libexec/cmux-sentinel (Homebrew: bin/ shim + libexec/ payload)
#   3. ~/bin                    (dispatcher elsewhere on PATH)
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CANDIDATES=("$HERE" "$HERE/../libexec/cmux-sentinel" "$HOME/bin")
REPO_URL="https://raw.githubusercontent.com/oliver-kriska/cmux-sentinel/main/install.sh"

# A source TREE (root of a checkout) rather than a directory of scripts: `deploy`
# needs install.sh plus sidebars/ and hooks/, which only exist together. Homebrew
# stages the whole tree under libexec, so $HERE/.. covers both it and a checkout;
# a ~/bin install has no tree, and falls back to the curl bootstrap's clone.
TREES=("$HERE/.." "$HERE/../libexec/cmux-sentinel" "${XDG_CACHE_HOME:-$HOME/.cache}/cmux-sentinel")

# Homebrew owns the file it installed; re-running the curl installer over the top
# would leave brew reporting a version it no longer controls.
brew_owned() { case "$HERE" in */Cellar/cmux-sentinel/*) return 0 ;; *) return 1 ;; esac; }

die() { echo "cmux-sentinel: $*" >&2; exit 1; }

# A version STRING is not a content hash. Between a release and the next tag the
# VERSION file does not move while the files do, so comparing versions alone
# answers "same" for two trees that differ — which is how the Cellar copy ends up
# running older code than ~/bin with nothing able to report it.
#
# Duplicated VERBATIM in install.sh (which writes the stamp); the dispatcher
# cannot source it, because Homebrew stages them in different trees. Change both.
payload_hash() { # $1 = source tree root; prints a short digest, or nothing
  local t="$1" sum=""
  [ -f "$t/VERSION" ] || return 1
  if command -v shasum >/dev/null 2>&1; then sum="shasum -a 256"
  elif command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"
  else return 1; fi   # no hasher: fail OPEN and let the caller skip the check
  # Fixed order, and an UNMATCHED glob must not poison the exit status: a tree
  # with no hooks/ makes `cat` fail, and under `pipefail` that turns the whole
  # assignment false — silently skipping the check that called this, which reads
  # exactly like "no drift". Test each path and end the subshell on a true.
  ( cd "$t" 2>/dev/null || exit 1
    for f in ./VERSION ./install.sh ./bin/*.sh ./hooks/* ./sidebars/*.swift; do
      [ -f "$f" ] && cat "$f"
    done
    true
  ) | $sum 2>/dev/null | cut -c1-12
}

# Numeric per component, so 0.10.0 > 0.9.0 — a string compare gets that backwards.
ver_lt() { # is $1 strictly older than $2?
  [ "$1" != "$2" ] || return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)" = "$1" ]
}

stamp_field() { # $1 = field name
  [ -f "$HOME/.config/cmux-sentinel/VERSION" ] || return 1
  sed -n "s/^$1=//p" "$HOME/.config/cmux-sentinel/VERSION"
}

# Find a helper script by name, or fail with the paths actually searched — a
# "command not found" that doesn't say where it looked is a support ticket.
resolve() { # $1 = script filename
  local d
  for d in "${CANDIDATES[@]}"; do
    [ -x "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
  done
  die "can't find $1 (looked in: ${CANDIDATES[*]}). Re-run the installer."
}

run() { local s; s="$(resolve "$1")" || exit 1; shift; exec "$s" "$@"; }

# install.sh is the ONE deployer; `deploy` locates it rather than reimplementing
# the copy/backup/plist/hook logic, which has its own 59-assertion test suite.
resolve_tree() {
  local d
  for d in "${TREES[@]}"; do
    [ -f "$d/install.sh" ] && [ -f "$d/bin/cmux-claude-usage.sh" ] && { (cd "$d" && pwd); return 0; }
  done
  return 1
}

usage_all() {
  # Each poller self-gates and exits 0 silently when its provider is disabled or
  # not installed, so asking all three is safe and needs no config parsing here.
  local p s out shown=0
  for p in claude codex amp; do
    s="$(resolve "cmux-$p-usage.sh" 2>/dev/null)" || continue
    # A poller that is gated off, offline or unauthenticated prints nothing here
    # and says why on stderr; that is its contract, so its exit status is not an
    # error for `usage` as a whole.
    out="$("$s" --print 2>/dev/null)" || true
    [ -n "$out" ] || continue
    shown=1
    printf '%s\n' "$out"
  done
  [ "$shown" = 1 ] || echo "no usage data — is any provider enabled in ~/.config/cmux/usage-sentinels.env?" >&2
  return 0
}

show_version() {
  local f="$HOME/.config/cmux-sentinel/VERSION" stamped="" rest cver
  if [ -f "$f" ]; then
    sed -n 's/^version=/cmux-sentinel /p;s/^installed=/  installed /p;s/^commit=/  commit    /p' "$f"
    stamped="$(sed -n 's/^version=//p' "$f")"
  else
    echo "cmux-sentinel (no version stamp — installed before v0.2.0, or copied by hand)"
    echo "  re-run the installer to record one:  cmux-sentinel update"
  fi
  # The stamp describes what is DEPLOYED — the pollers launchd actually runs. On
  # a Homebrew install that can diverge from the copy you just typed: `brew
  # upgrade` replaces the Cellar tree and changes nothing that is executing.
  # Reporting only one of the two numbers is how "I upgraded" and "it's still
  # broken" both stay true without anyone being able to see it.
  if brew_owned; then
    rest="${HERE#*/Cellar/cmux-sentinel/}"; cver="${rest%%/*}"
    echo "  homebrew  $cver (this command)"
    if [ -n "$stamped" ] && [ "$stamped" != "$cver" ]; then
      echo "  ⚠ ~/bin is still $stamped — run 'cmux-sentinel deploy' to put $cver there"
    fi
  fi
  # Equal version numbers do NOT mean equal files. A checkout sitting ahead of the
  # last tag deploys newer code under the released version, so the two copies read
  # the same string while differing — the one case the comparison above cannot see.
  local tree cur was
  was="$(stamp_field payload 2>/dev/null)"
  if [ -n "$was" ] && tree="$(resolve_tree)" && cur="$(payload_hash "$tree" 2>/dev/null)" \
     && [ -n "$cur" ] && [ "$cur" != "$was" ]; then
    echo "  ⚠ same version, DIFFERENT files: deployed payload $was, this tree $cur"
    echo "    this tree: $tree"
    echo "    'cmux-sentinel deploy' would overwrite ~/bin with this tree's copy."
  fi
  return 0
}

help_text() {
  cat <<'HELP'
cmux-sentinel — cmux sidebar with agent-state rows and AI usage meters

  cmux-sentinel setup           create/refresh the meter sentinels, park them out of ⌘1…⌘9
  cmux-sentinel doctor          health-check the whole pipeline (read-only)
  cmux-sentinel usage           print every enabled provider's usage
  cmux-sentinel paint           refresh the meters now (what launchd does every 5 min)
  cmux-sentinel deploy          copy this version's files into ~/bin and ~/.config
  cmux-sentinel update          fetch the latest release and re-install it
  cmux-sentinel version         what you have installed
  cmux-sentinel group-sync      sync workspace-GROUP names onto their anchor rows
  cmux-sentinel zed             open the current worktree in Zed (opt-in integration)

Anything after the command is passed through, so `cmux-sentinel usage --raw` and
`cmux-sentinel setup --no-layout` work. The underlying cmux-*.sh scripts are still
installed and still callable directly; launchd calls them by path.
HELP
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  setup)       run cmux-sentinel-setup.sh "$@" ;;
  doctor)      run cmux-sentinel-doctor.sh "$@" ;;
  version|--version|-V) show_version ;;
  usage)       usage_all "$@" ;;
  paint)
    # Same order the installer uses. Each poller self-gates, so a disabled or
    # uninstalled provider is a silent no-op rather than an error.
    for p in claude codex amp; do
      s="$(resolve "cmux-$p-usage.sh" 2>/dev/null)" || continue
      "$s" --update 2>/dev/null || true
    done
    command -v cmux >/dev/null 2>&1 && cmux sidebar reload >/dev/null 2>&1 \
      && echo "meters repainted, sidebar reloaded" \
      || echo "meters repainted (couldn't reach cmux to reload the sidebar)"
    ;;
  deploy)
    # Homebrew (and `git pull`) update the TREE; nothing under $HOME moves until
    # the installer runs. The meters live in ~/bin because four LaunchAgents call
    # them by absolute path, so "upgraded" without this step means new code sitting
    # in the Cellar while launchd keeps running the old copy — invisibly.
    t="$(resolve_tree)" || die "no source tree beside this script (looked in: ${TREES[*]}). Use \`cmux-sentinel update\` to fetch one."
    # `deploy` copies tree -> ~/bin, which ASSUMES the tree is at least as new as
    # what is installed. That is false whenever a checkout sits ahead of the last
    # tag: the Cellar still holds the released files while ~/bin holds newer ones,
    # and a plain deploy quietly reinstates the old pollers under launchd. Refuse
    # the two cases we can prove are not an upgrade; everything uncertain proceeds,
    # because a deploy that will not run is worse than one that re-copies the same
    # bytes. install.sh backs up whatever it replaces either way.
    args=(); force=0
    for a in "$@"; do
      if [ "$a" = "--force" ]; then force=1; else args+=("$a"); fi
    done
    if [ "$force" = 0 ]; then
      tver="$(cat "$t/VERSION" 2>/dev/null)"; sver="$(stamp_field version 2>/dev/null)"
      if [ -n "$tver" ] && [ -n "$sver" ] && ver_lt "$tver" "$sver"; then
        echo "cmux-sentinel: refusing to deploy BACKWARDS — this tree is v$tver, ~/bin has v$sver." >&2
        echo "  $t" >&2
        echo "  Deploying would replace the newer installed copy. Use --force if that is what you want." >&2
        exit 1
      fi
      swas="$(stamp_field payload 2>/dev/null)"; snow="$(payload_hash "$t" 2>/dev/null)"
      if [ -n "$swas" ] && [ -n "$snow" ] && [ "$swas" != "$snow" ] && [ "$tver" = "$sver" ]; then
        echo "cmux-sentinel: this tree and ~/bin are BOTH v$tver but their files differ." >&2
        echo "  deployed payload $swas, this tree $snow ($t)" >&2
        echo "  Same version is not same content, so this may not be an upgrade." >&2
        echo "  Re-run with --force to deploy this tree anyway." >&2
        exit 1
      fi
    fi
    exec "$t/install.sh" ${args[@]+"${args[@]}"}
    ;;
  update)
    # The installer's own bootstrap git-pulls the cache and re-execs, so this is
    # the documented update path rather than a second implementation of it.
    if brew_owned; then
      echo "This copy is managed by Homebrew. Update it with:" >&2
      echo "  brew upgrade cmux-sentinel && cmux-sentinel deploy" >&2
      exit 1
    fi
    command -v curl >/dev/null 2>&1 || die "curl is required to update"
    echo "Fetching the latest cmux-sentinel…"
    curl -fsSL "$REPO_URL" | bash -s -- "$@"
    ;;
  group-sync)  run cmux-group-sync.sh "$@" ;;
  zed)         run cmux-open-in-zed.sh "$@" ;;
  help|--help|-h) help_text ;;
  *)           echo "cmux-sentinel: unknown command '$cmd'" >&2; echo >&2; help_text >&2; exit 2 ;;
esac
